{
  "hosting": {
    "site": "event-med-ai",
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api",
        "run": {
          "serviceId": "event-med-backend",
          "region": "us-west1"
        }
      },
      {
        "source": "/api/**",
        "run": {
          "serviceId": "event-med-backend",
          "region": "us-west1"
        }
      },
      {
        "source": "/healthz",
        "run": {
          "serviceId": "event-med-backend",
          "region": "us-west1"
        }
      },
      {
        "source": "/uploads/**",
        "run": {
          "serviceId": "event-med-backend",
          "region": "us-west1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|png|jpg|svg|ico|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ]
  }
}
