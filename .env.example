# ── Database ──────────────────────────────────────────────────────────────────
# SQLite file path. WAL journal files (.db-wal, .db-shm) are created alongside.
DATABASE_URL=sqlite:///./backend/data/event_med.db

# ── Ollama ────────────────────────────────────────────────────────────────────
# URL of the running Ollama daemon.
OLLAMA_HOST=http://localhost:11434

# Primary and scale models for local AI.
MODEL_PRIMARY=gemma4:e2b
MODEL_SCALE=gemma4:e4b
MODEL_MEDICAL=

# ── Frontend & CORS ──────────────────────────────────────────────────────────
# Base URL the browser uses to reach the backend.
NEXT_PUBLIC_API_BASE=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Cloud Mode (Google AI Studio Gemini API) ──────────────────────────────────
# Set CLOUD_MODE=true to route all AI calls through Gemini Cloud.
# Zero-setup cost-free cloud testing.
CLOUD_MODE=false
GEMINI_API_KEY=
CLOUD_MODEL=gemini-2.5-flash

# ── Logging ───────────────────────────────────────────────────────────────────
DEBUG_MODE=true
EVENT_MED_DATA_DIR=./backend/data
